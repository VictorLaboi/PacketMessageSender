<Window x:Class="PacketMessageSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PacketMessageSender"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800">
    <Border Background="Gray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <Label Content="IP Adress:"/>
                    <TextBox 
                        HorizontalAlignment="Left"
                        Width="130"
                        Text="{Binding IPAdress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <Label Content="Port:"/>
                    <TextBox 
                        HorizontalAlignment="Left"
                        Width="130"
                        Text="{Binding IPAdress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button Width="80" Content="Add payload" 
                            HorizontalAlignment="Right"
                            Command="{Binding AddCommand}"/>
                    <Button Width="80" Content="Send" 
                            HorizontalAlignment="Right"
                            Command="{Binding SendCommand}"/>
                </DockPanel>
            </Grid>
            <Grid Grid.Column="0" Grid.Row="1">
                <ItemsControl ItemsSource="{Binding UserPayloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Fila con controles alineados horizontalmente -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <!-- PropertyName -->
                                    <ColumnDefinition Width="130" />
                                    <!-- Type_paload -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Payload_value -->
                                    <ColumnDefinition Width="100" />
                                    <!-- Payload_length -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Botón Eliminar -->
                                </Grid.ColumnDefinitions>

                                <!-- 1. Campo Nombre de Propiedad -->
                                <TextBox Grid.Column="0" 
                                     Text="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,5,0" 
                                     VerticalAlignment="Center"/>

                                <!-- 2. Selección de Tipo de Dato -->
                                <ComboBox Grid.Column="1" 
                                      SelectedItem="{Binding Type_paload, UpdateSourceTrigger=PropertyChanged}" 
                                      Margin="0,0,5,0" 
                                      VerticalAlignment="Center">
                                    <ComboBoxItem Content="System.Int32" />
                                    <ComboBoxItem Content="System.Double" />
                                    <ComboBoxItem Content="System.String" />
                                    <ComboBoxItem Content="System.Boolean" />
                                </ComboBox>

                                <!-- 3. Campo Valor -->
                                <TextBox Grid.Column="2" 
                         Text="{Binding Payload_value, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,5,0" 
                         VerticalAlignment="Center"/>

                                <!-- (Opcional) Campo Longitud Personalizada -->
                                <TextBox Grid.Column="3" 
                                     Text="{Binding Payload_length, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,5,0" 
                                     VerticalAlignment="Center"
                                     ToolTip="Longitud fija en bytes (0 = por defecto)"/>

                                <!-- 4. Botón Eliminar -->
                                <Button Grid.Column="4" 
                                Content="Eliminar" 
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                CommandParameter="{Binding}"
                                Padding="10,2"
                                VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>
